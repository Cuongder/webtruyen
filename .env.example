# Database Configuration (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/mocthu?sslmode=require"

# Authentication Security Secret (Must be 32+ random characters in production)
JWT_SECRET="replace-with-random-32-byte-secret"

# Brand & Domain Configuration
NEXT_PUBLIC_SITE_NAME="Mộc Thư"
NEXT_PUBLIC_SITE_URL="https://your-domain.example"
NEXT_PUBLIC_SITE_DESCRIPTION="Nền tảng đọc và sáng tác truyện chữ trực tuyến tiếng Việt cao cấp, chuẩn Mobile First"

# Admin API secret
ADMIN_API_KEY=replace-with-random-admin-secret
